# Nova Cash — variables de entorno públicas (Cap. 9.18 / 11.4)
# Copia este archivo a `.env` y completa los valores. NUNCA subas `.env` al repo.

VITE_APP_NAME="Nova Cash"
VITE_APP_VERSION="0.1.0"

# Supabase (proyecto por ambiente: dev / stage / prod — ADR-049)
# URL base del proyecto (SIN /rest/v1). Key = "Publishable key" (sb_publishable_...) o la anon.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# --- Variables PRIVADAS (NO usar el prefijo VITE_, nunca llegan al cliente) ---
# Se configuran en el entorno del servidor / CI, jamás en el repositorio:
# SUPABASE_SERVICE_ROLE_KEY=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# APPLE_TEAM_ID=
